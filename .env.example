# TrustLend Environment Configuration Example
# Copy this file to .env and provide your actual API keys

# Option 1: Twilio SMS Provider
VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
VITE_TWILIO_PHONE_NUMBER=+1234567890

# Option 2: Generic / Fast2SMS Provider
# VITE_SMS_API_KEY=your_sms_gateway_api_key_here
