# TrustLend Environment Configuration Example
# Copy this file to .env and provide your actual API keys

# --- SMS OTP PROVIDERS ---
# Option 1: Twilio SMS Gateway
VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
VITE_TWILIO_PHONE_NUMBER=+1234567890

# Option 2: Generic / Fast2SMS Gateway
# VITE_SMS_API_KEY=your_sms_gateway_api_key_here

# --- IDENTITY VERIFICATION PROVIDERS ---
# Option 1: Persona Identity Verification
VITE_IDENTITY_PROVIDER_KEY=your_persona_api_key_here
VITE_PERSONA_TEMPLATE_ID=your_persona_template_id_here

# Option 2: Onfido Identity Verification
# VITE_ONFIDO_API_TOKEN=your_onfido_api_token_here
